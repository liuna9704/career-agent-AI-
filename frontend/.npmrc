# 锁定依赖解析行为，避免"Windows 生成 lock、Linux 上 npm ci 失败"

# 保留所有平台的原生可选依赖（rolldown / lightningcss 等按平台分发），
# 否则生成的 lock 会缺少其他平台所需的包，导致 CI 上报
# "can only install packages when your package.json and package-lock.json
# are in sync"。
include=optional

# 官方源，保证 GitHub Runner 与本地解析结果一致
registry=https://registry.npmjs.org/
