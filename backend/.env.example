# 复制本文件为 .env 后填写。全部留空也能跑通完整 Demo（自动降级模式）。

# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- 大模型（OpenAI 兼容接口）----
# 例：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60
# 为 true 时，模型不可用会自动降级为本地规则分析，Demo 不中断
LLM_MOCK_FALLBACK=true

# ---- Embedding（OpenAI 兼容接口）----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=60
# 留空则使用内置的本地 hash 向量，无需联网
EMBEDDING_MOCK_FALLBACK=true
EMBEDDING_FALLBACK_DIMENSION=384

# ---- 向量库目录（可选）----
# faiss-cpu 在 Windows 下无法读写含中文的路径，若项目路径含中文，
# 可在此显式指定一个纯英文目录；留空则自动回退到系统临时目录。
# VECTOR_STORE_DIR=D:\career_agent_vector_store
